{
  "name": "tsundoku",
  "version": "0.1.0",
  "description": "OPDS 1.2 + 2.0 catalog, upload UI and KOReader sync server on one Cloudflare Worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "./build.sh && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply tsundoku --remote",
    "db:migrate:local": "wrangler d1 migrations apply tsundoku --local",
    "db:backup": "./scripts/backup.sh",
    "setup": "./scripts/setup.sh",
    "conformance": "node test/conformance/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
